"""Types of the compiled transcoder module, ``_transcoder.pyx``."""

import numpy as np
import numpy.typing as npt

MAX_FILE_SIZE: int

_Info = tuple[int, int, int, int, int, int, bool, bool, bool, bool]

def target_name(target: int) -> str: ...
def target_bytes(target: int) -> int: ...
def target_block(target: int) -> tuple[int, int]: ...
def target_is_uncompressed(target: int) -> bool: ...
def target_supported(target: int, codec: int) -> bool: ...
def codec_hdr(codec: int) -> bool: ...

class KTX2File:
    def __init__(self, data: bytes) -> None: ...
    def info(self) -> _Info: ...
    def start(self) -> bool: ...
    def is_video(self) -> bool: ...
    def level(self, level_index: int, layer: int, face: int) -> tuple[int, int, bool] | None: ...
    def transcode(
        self,
        level_index: int,
        layer: int,
        face: int,
        target: int,
        output: npt.NDArray[np.uint8],
        output_size: int,
        row_pitch: int,
        rows: int,
    ) -> bool: ...

class BasisFile:
    def __init__(self, data: bytes) -> None: ...
    def info(self) -> _Info: ...
    def start(self) -> bool: ...
    def is_video(self) -> bool: ...
    def level(self, level_index: int, layer: int, face: int) -> tuple[int, int, bool] | None: ...
    def transcode(
        self,
        level_index: int,
        layer: int,
        face: int,
        target: int,
        output: npt.NDArray[np.uint8],
        output_size: int,
        row_pitch: int,
        rows: int,
    ) -> bool: ...
